# Copy to backend/.env. No account credentials are included.
MONGO_URL="mongodb://127.0.0.1:27027"
DB_NAME="huolitsija_local"
CORS_ORIGINS="http://localhost:3000"
COOKIE_SECURE=false
EMAIL_PROVIDER=log
SMS_PROVIDER=log
TULLI_MODE=disabled
SEED_DEMO=true
JOBS_WORKER_ENABLED=false
DIGITRAFFIC_ENABLED=false
DEMO_AUTOQUOTE_ENABLED=false
# Choose local-only passwords before starting. Empty means the user is not created.
DEMO_OPS_PASSWORD=
DEMO_CUSTOMER_PASSWORD=
DEMO_PARTNER_PASSWORD=
# Secrets (never commit): OPENAI_API_KEY, STRIPE_API_KEY, STRIPE_WEBHOOK_SECRET,
# DEMO_OPS_PASSWORD, DEMO_CUSTOMER_PASSWORD, DEMO_PARTNER_PASSWORD. See docs/INTEGRATIONS.md.

# ---- Optional settings (unset = safe default). Values never go in this file. ----
# Public origin used in e-mails and payment redirects; unset = the request's own origin.
# APP_BASE_URL=http://localhost:3000
# JWT_SECRET=            # unset = generated once and kept in the database
# SESSION_DAYS=14
# TRUSTED_PROXY_HOPS=1
# AI: OpenAI API only. Supply OPENAI_API_KEY securely.
LLM_PROVIDER=openai
LLM_MODEL=gpt-6.1-sol
# LLM_MODEL_FAST inherits LLM_MODEL unless explicitly set to a verified model ID.
# Production e-mail: EMAIL_PROVIDER=postmark, POSTMARK_SERVER_TOKEN supplied securely,
# EMAIL_FROM=Huolitsija <noreply@example.com>
# Payments: STRIPE_API_KEY (sk_test_/rk_test_ = test mode), STRIPE_WEBHOOK_SECRET or its alias PAYMENT_WEBHOOK_SIGNING_SECRET (optional; payment-status works without it)
# E-mail: EMAIL_PROVIDER=log|postmark|resend|smtp2go, EMAIL_FROM, POSTMARK_SERVER_TOKEN, RESEND_API_KEY, SMTP2GO_API_KEY
# Demo logins (created only when set): DEMO_OPS_EMAIL, DEMO_OPS_PASSWORD, DEMO_CUSTOMER_PASSWORD, DEMO_PARTNER_PASSWORD
# Company identity on invoices and declarations (shown as "pending" until set):
#     COMPANY_NAME, COMPANY_BUSINESS_ID, COMPANY_VAT_ID, COMPANY_EORI, COMPANY_ADDRESS, COMPANY_EMAIL, COMPANY_PHONE,
#     COMPANY_IBAN, COMPANY_BIC, DEFAULT_PAYMENT_TERMS_DAYS
# Invoicing (V4): INVOICE_AUTO_ISSUE, VAT_TEXT_ZERO_EXPORT_FI/_EN, VAT_TEXT_ZERO_INTL_FI/_EN (tax-adviser wording), EXC_* (exception timers)
# Quotes (V2): QUOTE_APPROVAL_THRESHOLD_EUR, QUOTE_CUSTOMS_INCLUDED_ITEMS, QUOTE_CUSTOMS_FEE_VAT_CODE,
#     QUOTE_DOMESTIC_LEG_VAT_CODE, PUBLIC_QUOTE_RATE_LIMIT_PER_HOUR, SEA_AVOID_RED_SEA
# Customs (V3): TULLI_MODE=disabled|test|production, TULLI_ENDPOINT, TULLI_DECLARANT_ID, TULLI_CLIENT_CERT, TULLI_CLIENT_KEY
# Tracking and maps (V1): POSITION_TICK_SECONDS, DHL_API_KEY, OSRM_URL, PHOTON_URL, GEOCODER_URL

# Public legal identity (s4): set only after confirming the registration.
COMPANY_REGISTERED=false
COMPANY_REGISTERED_OFFICE=
COMPANY_PRIVACY_EMAIL=
# COMPANY_ADDRESS must contain the real postal address; no address is invented by /api/legal/config.
