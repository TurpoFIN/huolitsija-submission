<?xml version="1.0" encoding="UTF-8"?>
<!-- 
Name: ApplicationMessageTypes.xsd
v1.21 released 2018-01-11 by Finnish Customs
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
	xmlns:mess="http://tulli.fi/schema/corporateservice/v1" 
	targetNamespace="http://tulli.fi/schema/corporateservice/v1"
	elementFormDefault="qualified" attributeFormDefault="unqualified" version="v1_21">
	<xs:simpleType name="BusinessId">
		<xs:annotation>
			<xs:documentation>The unique business identity code</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="9"/>
			<xs:maxLength value="17"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MessageStorageId">
		<xs:annotation>
			<xs:documentation>A unique identifier for a stored message. The identifier is generated by Customs.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="64"/>
			<xs:minLength value="1"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="DocumentId">
		<xs:annotation>
			<xs:documentation>A unique identifier for a stored document. The identifier is generated by Customs.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[A-Z][A-Z]-[0-9]{1,1021}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Reference">
		<xs:annotation>
			<xs:documentation>An identifier given by the customer (Message Builder) to identify this particular interchange. The reference must be unique for the combination of application and declarant.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[a-zA-Z0-9_\-]{6,14}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Application">
		<xs:annotation>
			<xs:documentation>The short name of the target Customs application.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="16"/>
			<xs:minLength value="1"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ContentFormat">
		<xs:annotation>
			<xs:documentation>The format of the content as MIME media type string. The value "xml" is included for backward compatibility only; "application/xml" should be used instead.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="application/xml|application/pdf|application/zip|[Xx][Mm][Ll]|image/jpeg|image/png|image/tiff"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Title">
		<xs:annotation>
			<xs:documentation/>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="255"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Description">
		<xs:annotation>
			<xs:documentation>Description or any additional information</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="255"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="DocumentType">
		<xs:annotation>
			<xs:documentation>Customs defined code identifying the type of the related document.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="16"/>
			<xs:minLength value="1"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="CustomsRequest">
		<xs:annotation>
			<xs:documentation>Boolean indicating is attachment requested by Customs.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:boolean">
			<xs:pattern value="true"/>
			<xs:pattern value="false"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="RelationIdentifier">
		<xs:annotation>
			<xs:documentation>Unique identifier of the parent document of the attachment.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="44"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="LanguageCode">
		<xs:annotation>
			<xs:documentation>The language code.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="EN|FI|SV|en|fi|sv"/>
		</xs:restriction>
	</xs:simpleType>	
	<xs:complexType name="ApplicationContent">
		<xs:annotation>
			<xs:documentation>Customs application content</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Content">
				<xs:annotation>
					<xs:documentation>The actual content, e.g. customs declaration.</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:base64Binary"/>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ContentFormat" type="mess:ContentFormat"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EncryptionInformation">
		<xs:annotation>
			<xs:documentation>For future needs: Encryption information</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Encryption">
				<xs:annotation>
					<xs:documentation>For future needs: Encryption indicator for content and encryption request for responses</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:boolean"/>
				</xs:simpleType>
			</xs:element>
			<xs:element name="EncryptionMethod">
				<xs:annotation>
					<xs:documentation>For future needs: Name of the encryption algorithm</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="1"/>
						<xs:maxLength value="35"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CompressionInformation">
		<xs:annotation>
			<xs:documentation>For future needs: Compression information</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Compression">
				<xs:annotation>
					<xs:documentation>For future needs: Compression indicator for content and encryption request for responses</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:boolean"/>
				</xs:simpleType>
			</xs:element>
			<xs:element name="CompressionMethod">
				<xs:annotation>
					<xs:documentation>For future needs: Name of the compression algorithm</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="1"/>
						<xs:maxLength value="35"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
