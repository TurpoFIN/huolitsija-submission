 "schemas": {
  "QuoteRequest": {
   "type": "object",
   "properties": {
    "commodities": {
     "type": "array",
     "items": {
      "$ref": "#/components/schemas/QuoteRequestCommodity"
     },
     "description": "Commodities in the shipment"
    },
    "commodityDescription": {
     "type": "string",
     "description": "Full description of the shipment"
    },
    "CIFMarkup": {
     "type": "number",
     "description": "CIF markup percentage"
    },
    "freightAndOtherExpenses": {
     "type": "number",
     "description": "Freight and other expenses"
    },
    "trackingCode": {
     "type": "string"
    },
    "marksNumbers": {
     "type": "string"
    },
    "letterOfCredit": {
     "type": "string"
    },
    "voyageNumber": {
     "type": "string"
    },
    "origin": {
     "$ref": "#/components/schemas/QuoteRequestAddress"
    },
    "originType": {
     "type": "string",
     "enum": [
      "ADDRESS",
      "IATA",
      "LOCODE",
      "CITY",
      "FREETEXT",
      "WAREHOUSE"
     ],
     "example": "ADDRESS",
     "description": "Specify a special type for origin address, Redkik will perform post processing based on the formatted value"
    },
    "destination": {
     "$ref": "#/components/schemas/QuoteRequestAddress"
    },
    "destinationType": {
     "type": "string",
     "enum": [
      "ADDRESS",
      "IATA",
      "LOCODE",
      "CITY",
      "FREETEXT",
      "WAREHOUSE"
     ],
     "example": "ADDRESS",
     "description": "Specify a special type for destination address, Redkik will perform post processing based on the formatted value"
    },
    "startDate": {
     "type": "string",
     "example": "2023-01-01T00:00:00Z",
     "description": "Start date and time of the insurance cover, omitting timezone information will default to servers timezone",
     "format": "isNotBlank",
     "minLength": 1
    },
    "endDate": {
     "type": "string",
     "example": "2023-01-01T00:00:00Z",
     "description": "End date and time of the insurance cover, omitting timezone information will default to servers timezone",
     "format": "isNotBlank",
     "minLength": 1
    },
    "conveyanceType": {
     "type": "string",
     "enum": [
      "SEA",
      "AIR",
      "ROAD",
      "RAIL",
      "ALL",
      "LAND"
     ],
     "example": "ROAD",
     "description": "Mode of transport for this journey leg"
    },
    "conveyanceDescriptor": {
     "type": "string",
     "example": "redkik:conveyanceDescriptors.sea.underDeck",
     "description": "Descriptor for transport mode",
     "enum": [
      "redkik:conveyanceDescriptors.sea.underDeck",
      "redkik:conveyanceDescriptors.sea.onDeck",
      "redkik:conveyanceDescriptors.sea.openTop",
      "redkik:conveyanceDescriptors.sea.flatRack",
      "redkik:conveyanceDescriptors.sea.roro",
      "redkik:conveyanceDescriptors.sea.roroOnDeck",
      "redkik:conveyanceDescriptors.sea.fcl",
      "redkik:conveyanceDescriptors.sea.lcl",
      "redkik:conveyanceDescriptors.sea.barge",
      "redkik:conveyanceDescriptors.sea.tow",
      "redkik:conveyanceDescriptors.sea.breakbulk",
      "redkik:conveyanceDescriptors.sea.bulk",
      "redkik:conveyanceDescriptors.air.international",
      "redkik:conveyanceDescriptors.air.domestic",
      "redkik:conveyanceDescriptors.road.enclosed",
      "redkik:conveyanceDescriptors.road.enclosedFullTrailerLoad",
      "redkik:conveyanceDescriptors.road.enclosedGroupageLoad",
      "redkik:conveyanceDescriptors.road.enclosedLessThanTrailerLoad",
      "redkik:conveyanceDescriptors.road.flatbed",
      "redkik:conveyanceDescriptors.road.refrigerated",
      "redkik:conveyanceDescriptors.road.parcelPost",
      "redkik:conveyanceDescriptors.rail.boxcar",
      "redkik:conveyanceDescriptors.rail.flatcar",
      "redkik:conveyanceDescriptors.rail.intermodalOrContainerWagon",
      "redkik:conveyanceDescriptors.rail.hopperWagonOpen",
      "redkik:conveyanceDescriptors.rail.hopperWagonCovered",
      "redkik:conveyanceDescriptors.rail.gondola",
      "redkik:conveyanceDescriptors.rail.tanker",
      "redkik:conveyanceDescriptors.rail.autorack",
      "redkik:conveyanceDescriptors.rail.coilCar",
      "redkik:conveyanceDescriptors.rail.reefer"
     ]
    },
    "loadingSpace": {
     "type": "string",
     "description": "Identifier for searching exitSpaceId, used if id is not given"
    },
    "loadingSpaceType": {
     "type": "string",
     "enum": [
      "PORT_LOCODE",
      "AIRPORT_IATA",
      "AIRPORT_ICAO",
      "VESSEL_IMO",
      "VESSEL_MMSI",
      "FLIGHT_IATA",
      "FLIGHT_ICAO"
     ],
     "description": "Identifier type for searching exitSpaceId, used if id is not given"
    },
    "dischargeSpace": {
     "type": "string",
     "description": "Identifier for searching entrySpaceId, used if id is not given"
    },
    "dischargeSpaceType": {
     "type": "string",
     "enum": [
      "PORT_LOCODE",
      "AIRPORT_IATA",
      "AIRPORT_ICAO",
      "VESSEL_IMO",
      "VESSEL_MMSI",
      "FLIGHT_IATA",
      "FLIGHT_ICAO"
     ],
     "description": "Identifier type for searching entrySpaceId, used if id is not given"
    },
    "conveyanceSpace": {
     "type": "string",
     "description": "Identifier for searching conveyanceSpaceId, used if id is not given"
    },
    "conveyanceSpaceType": {
     "type": "string",
     "enum": [
      "PORT_LOCODE",
      "AIRPORT_IATA",
      "AIRPORT_ICAO",
      "VESSEL_IMO",
      "VESSEL_MMSI",
      "FLIGHT_IATA",
      "FLIGHT_ICAO"
     ],
     "description": "Identifier type for searching conveyanceSpaceId, used if id is not given"
    },
