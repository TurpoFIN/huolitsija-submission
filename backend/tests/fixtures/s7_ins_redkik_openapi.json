     "type": "string",
     "deprecated": true,
     "example": "FI",
     "description": "Country component of the origin address for the covered load, if omitted formatted address is required"
    },
    "destinationFormatted": {
     "type": "string",
     "deprecated": true,
     "example": "Länsikatu 15, Joensuu 80110, FI",
     "description": "Full destination address for the covered load, if omitted individual address components are required"
    },
