     "type": "boolean",
     "description": "Set to true when the vessel cannot be found by identifier. Skips conveyanceSpace lookup entirely and uses customVesselName instead"
    },
    "customVesselName": {
     "type": "string",
     "example": "MV Example Carrier",
     "description": "Manually entered vessel name, used when unableToFindVessel is true. Ignored otherwise"
    },
    "bookingFee": {
     "type": "number"
    },
    "bookingFeeType": {
     "anyOf": [
      {
       "type": "string",
       "enum": [
        "PERCENT",
        "FLAT_FEE"
       ]
